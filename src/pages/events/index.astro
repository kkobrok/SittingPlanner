---
import AppShell from "../../layouts/AppShell.astro";
export const prerender = false;

interface EventItem {
  id: number;
  name: string;
  date?: string;
  guest_count?: number;
  table_count?: number;
}

let events: EventItem[] = [];
try {
  const res = await fetch("/api/events");
  if (res.ok) {
    const data = await res.json();
    events = data.data ?? [];
  }
} catch (error) {
  // Silently fail
}
---

<AppShell title="Events">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold">Your Events</h1>
    <a
      href="/events/create"
      class="rounded-full bg-pink-500 hover:bg-pink-600 text-white px-6 py-3 text-sm font-semibold shadow">New Event</a
    >
  </div>
  {
    events.length === 0 ? (
      <div class="text-center bg-white p-10 rounded-3xl border border-white/40 shadow">
        <p class="text-gray-700 mb-4">No events yet.</p>
        <a href="/events/create" class="text-pink-600 font-semibold">
          Create your first event
        </a>
      </div>
    ) : (
      <div class="grid md:grid-cols-3 gap-6">
        {events.map((ev) => (
          <a
            href={`/events/${ev.id}/plan`}
            class="group bg-white rounded-2xl p-5 border border-white/40 shadow hover:shadow-md transition"
          >
            <h2 class="font-semibold text-gray-900 mb-2 group-hover:text-pink-600">{ev.name}</h2>
            <p class="text-sm text-gray-600">Date: {ev.date}</p>
            <p class="text-xs text-gray-500 mt-2">
              Guests: {ev.guest_count ?? 0} · Tables: {ev.table_count ?? 0}
            </p>
          </a>
        ))}
      </div>
    )
  }
</AppShell>
