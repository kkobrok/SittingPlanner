---
import AppShell from "../../../layouts/AppShell.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import EventNavTabs from "../../../components/EventNavTabs.astro";
export const prerender = false;
const { params } = Astro;
const eventId = params.eventId;
---

<AppShell title="Guest Management">
  <!-- Header with Navigation -->
  <div class="mb-8">
    <Breadcrumbs
      items={[
        { label: "Dashboard", href: "/dashboard" },
        { label: "Event", href: "#" },
        { label: "Guests" },
      ]}
    />

    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight">Guest Management</h1>
        <p class="text-sm text-muted-foreground mt-2">Manage guests for this event</p>
      </div>
      <button
        id="addGuestBtn"
        class="inline-flex items-center justify-center h-10 px-5 rounded-lg bg-primary text-primary-foreground font-semibold shadow-[var(--shadow-sm)] hover:bg-primary/90 hover:shadow-[var(--shadow-md)] active:shadow-[var(--shadow-sm)] active:scale-[0.98] transition-all duration-150"
      >
        + Add Guest
      </button>
    </div>

    <EventNavTabs eventId={eventId!} activeTab="guests" />
  </div>

  <!-- Stats Summary -->
  <div id="statsContainer" class="grid md:grid-cols-4 gap-4 mb-6">
    <!-- Stats will be populated by JavaScript -->
  </div>

  <!-- Search and Actions -->
  <div class="mb-6 flex flex-col sm:flex-row gap-3">
    <div class="flex-1 relative">
      <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input
        id="searchInput"
        type="text"
        placeholder="Search guests by name..."
        class="w-full h-10 pl-10 pr-4 rounded-lg border border-input bg-card/95 backdrop-blur-sm text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
      />
    </div>
    <div class="sm:w-48">
      <select
        id="sortSelect"
        class="w-full h-10 px-4 rounded-lg border border-input bg-card/95 backdrop-blur-sm text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
      >
        <option value="name-asc">Name (A-Z)</option>
        <option value="name-desc">Name (Z-A)</option>
        <option value="created-desc">Recently Added</option>
        <option value="created-asc">Oldest Added</option>
      </select>
    </div>
  </div>

  <!-- Guests Container -->
  <div id="guestsContainer">
    <!-- Skeleton loaders -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="skeleton-card">
        <div class="skeleton-line skeleton-title"></div>
        <div class="skeleton-line skeleton-stat"></div>
        <div class="skeleton-line skeleton-stat"></div>
      </div>
      <div class="skeleton-card">
        <div class="skeleton-line skeleton-title"></div>
        <div class="skeleton-line skeleton-stat"></div>
        <div class="skeleton-line skeleton-stat"></div>
      </div>
      <div class="skeleton-card">
        <div class="skeleton-line skeleton-title"></div>
        <div class="skeleton-line skeleton-stat"></div>
        <div class="skeleton-line skeleton-stat"></div>
      </div>
    </div>
  </div>

  <style>
    @keyframes shimmer {
      0% { background-position: -1000px 0; }
      100% { background-position: 1000px 0; }
    }

    .skeleton-card {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(10px);
      border-radius: 1rem;
      padding: 1.5rem;
      border: 1px solid rgba(255, 255, 255, 0.4);
      box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
      min-height: 140px;
      display: flex;
      flex-direction: column;
    }

    .skeleton-line {
      background: linear-gradient(
        90deg,
        rgba(203, 213, 225, 0.4) 0%,
        rgba(226, 232, 240, 0.6) 50%,
        rgba(203, 213, 225, 0.4) 100%
      );
      background-size: 1000px 100%;
      animation: shimmer 2s infinite;
      border-radius: 0.5rem;
    }

    .skeleton-title {
      height: 1.5rem;
      width: 60%;
      margin-bottom: 0.75rem;
    }

    .skeleton-stat {
      height: 1rem;
      width: 100%;
      margin-bottom: 0.5rem;
    }
  </style>

  <!-- Add Guest Modal -->
  <div id="addGuestModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="bg-card rounded-2xl p-6 max-w-2xl w-full shadow-[var(--shadow-xl)] border border-border max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-semibold tracking-tight">Add Guest</h2>
        <button id="closeAddModalBtn" class="text-muted-foreground hover:text-foreground text-2xl leading-none transition-colors duration-150">
          &times;
        </button>
      </div>

      <form id="addGuestForm" class="space-y-5">
        <!-- Basic Information -->
        <div>
          <label for="guestName" class="block text-sm font-semibold mb-2">
            Guest Name <span class="text-destructive">*</span>
          </label>
          <input
            id="guestName"
            type="text"
            required
            placeholder="e.g., John Smith"
            class="w-full h-10 rounded-lg border border-input bg-background px-3.5 text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
          />
        </div>

        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label for="guestAge" class="block text-sm font-semibold mb-2">Age Range</label>
            <select
              id="guestAge"
              class="w-full h-10 rounded-lg border border-input bg-background px-3.5 text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
            >
              <option value="">Not specified</option>
              <option value="child">Child</option>
              <option value="teen">Teen</option>
              <option value="adult">Adult</option>
              <option value="senior">Senior</option>
            </select>
          </div>

          <div>
            <label for="guestDrinking" class="block text-sm font-semibold mb-2">Drinking Habits</label>
            <select
              id="guestDrinking"
              class="w-full h-10 rounded-lg border border-input bg-background px-3.5 text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
            >
              <option value="">Not specified</option>
              <option value="none">None</option>
              <option value="light">Light</option>
              <option value="moderate">Moderate</option>
              <option value="heavy">Heavy</option>
            </select>
          </div>
        </div>

        <div>
          <label for="guestDiet" class="block text-sm font-semibold mb-2">Dietary Restrictions</label>
          <input
            id="guestDiet"
            type="text"
            placeholder="e.g., Vegetarian, Gluten-free, Nut allergy"
            class="w-full h-10 rounded-lg border border-input bg-background px-3.5 text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
          />
        </div>

        <div>
          <label for="guestHobbies" class="block text-sm font-semibold mb-2">Hobbies / Interests</label>
          <input
            id="guestHobbies"
            type="text"
            placeholder="e.g., Golf, Photography, Cooking"
            class="w-full h-10 rounded-lg border border-input bg-background px-3.5 text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
          />
        </div>

        <div>
          <label for="guestAvoid" class="block text-sm font-semibold mb-2">Topics to Avoid</label>
          <input
            id="guestAvoid"
            type="text"
            placeholder="e.g., Politics, Religion"
            class="w-full h-10 rounded-lg border border-input bg-background px-3.5 text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
          />
        </div>

        <div class="flex gap-3 pt-2">
          <button
            type="button"
            id="cancelAddBtn"
            class="flex-1 h-10 rounded-lg border-2 border-border bg-card/50 backdrop-blur-sm font-semibold text-sm hover:bg-accent hover:border-accent-foreground/20 active:bg-accent/80 transition-all duration-150"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="flex-1 h-10 rounded-lg bg-primary text-primary-foreground font-semibold text-sm shadow-[var(--shadow-sm)] hover:bg-primary/90 hover:shadow-[var(--shadow-md)] active:shadow-[var(--shadow-sm)] active:scale-[0.98] transition-all duration-150"
          >
            Add Guest
          </button>
        </div>

        <p id="addGuestStatus" class="text-sm text-destructive hidden mt-2" role="alert" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <!-- Edit Guest Modal -->
  <div id="editGuestModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50">
    <div class="bg-white/90 backdrop-blur rounded-3xl p-8 max-w-2xl w-full mx-4 shadow-2xl border border-white/40 max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Edit Guest</h2>
        <button id="closeEditModalBtn" class="text-gray-500 hover:text-gray-700 text-2xl leading-none">
          &times;
        </button>
      </div>

      <form id="editGuestForm" class="space-y-4">
        <!-- Basic Information -->
        <div>
          <label for="editGuestName" class="block text-sm font-medium text-gray-700 mb-1">
            Guest Name <span class="text-red-500">*</span>
          </label>
          <input
            id="editGuestName"
            type="text"
            required
            placeholder="e.g., John Smith"
            class="w-full rounded-xl border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"
          />
        </div>

        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label for="editGuestAge" class="block text-sm font-medium text-gray-700 mb-1">Age Range</label>
            <select
              id="editGuestAge"
              class="w-full rounded-xl border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"
            >
              <option value="">Not specified</option>
              <option value="child">Child</option>
              <option value="teen">Teen</option>
              <option value="adult">Adult</option>
              <option value="senior">Senior</option>
            </select>
          </div>

          <div>
            <label for="editGuestDrinking" class="block text-sm font-medium text-gray-700 mb-1">Drinking Habits</label>
            <select
              id="editGuestDrinking"
              class="w-full rounded-xl border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"
            >
              <option value="">Not specified</option>
              <option value="none">None</option>
              <option value="light">Light</option>
              <option value="moderate">Moderate</option>
              <option value="heavy">Heavy</option>
            </select>
          </div>
        </div>

        <div>
          <label for="editGuestDiet" class="block text-sm font-medium text-gray-700 mb-1">Dietary Restrictions</label>
          <input
            id="editGuestDiet"
            type="text"
            placeholder="e.g., Vegetarian, Gluten-free, Nut allergy"
            class="w-full rounded-xl border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"
          />
        </div>

        <div>
          <label for="editGuestHobbies" class="block text-sm font-medium text-gray-700 mb-1">Hobbies / Interests</label>
          <input
            id="editGuestHobbies"
            type="text"
            placeholder="e.g., Golf, Photography, Cooking"
            class="w-full rounded-xl border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"
          />
        </div>

        <div>
          <label for="editGuestAvoid" class="block text-sm font-medium text-gray-700 mb-1">Topics to Avoid</label>
          <input
            id="editGuestAvoid"
            type="text"
            placeholder="e.g., Politics, Religion"
            class="w-full rounded-xl border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-pink-500"
          />
        </div>

        <div class="flex gap-3 pt-4">
          <button
            type="button"
            id="cancelEditBtn"
            class="flex-1 rounded-lg border-2 border-border bg-card/50 backdrop-blur-sm font-semibold px-6 py-2 hover:bg-accent hover:border-accent-foreground/20 active:bg-accent/80 transition-all duration-150"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="flex-1 rounded-full bg-primary hover:bg-primary/90 shadow-[var(--shadow-sm)] hover:shadow-[var(--shadow-md)] active:scale-[0.98] text-white font-semibold px-6 py-2 transition-colors"
          >
            Save Changes
          </button>
        </div>

        <p id="editGuestStatus" class="text-sm text-red-600 hidden mt-2" role="alert" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <!-- Delete Guest Modal -->
  <div id="deleteGuestModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50">
    <div class="bg-white/90 backdrop-blur rounded-3xl p-8 max-w-md w-full mx-4 shadow-2xl border border-white/40">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Delete Guest</h2>
        <button id="closeDeleteModalBtn" class="text-gray-500 hover:text-gray-700 text-2xl leading-none">
          &times;
        </button>
      </div>

      <p class="text-gray-700 mb-6">
        Are you sure you want to delete <strong id="deleteGuestName"></strong>? This action cannot be undone.
      </p>

      <div class="flex gap-3">
        <button
          id="cancelDeleteBtn"
          class="flex-1 rounded-lg border-2 border-border bg-card/50 backdrop-blur-sm font-semibold px-6 py-2 hover:bg-accent hover:border-accent-foreground/20 active:bg-accent/80 transition-all duration-150"
        >
          Cancel
        </button>
        <button
          id="confirmDeleteBtn"
          class="flex-1 rounded-full bg-destructive hover:bg-destructive/90 shadow-[var(--shadow-sm)] hover:shadow-[var(--shadow-md)] active:scale-[0.98] text-white font-semibold px-6 py-2 transition-colors"
        >
          Delete Guest
        </button>
      </div>

      <p id="deleteGuestStatus" class="text-sm text-red-600 hidden mt-4" role="alert" aria-live="polite"></p>
    </div>
  </div>

  <script is:inline define:vars={{ eventId }}>
    (function() {
      console.log('[Guests] Script loaded for event:', eventId);

      // State
      let guests = [];
      let assignments = [];
      let filteredGuests = [];
      let searchTerm = '';
      let sortOrder = 'name-asc';
      let eventData = null;

      // Elements
      const guestsContainer = document.getElementById('guestsContainer');
      const statsContainer = document.getElementById('statsContainer');
      const breadcrumbEventName = document.getElementById('breadcrumbEventName');
      const addGuestBtn = document.getElementById('addGuestBtn');
      const addGuestModal = document.getElementById('addGuestModal');
      const addGuestForm = document.getElementById('addGuestForm');
      const closeAddModalBtn = document.getElementById('closeAddModalBtn');
      const cancelAddBtn = document.getElementById('cancelAddBtn');
      const addStatusEl = document.getElementById('addGuestStatus');
      const searchInput = document.getElementById('searchInput');
      const sortSelect = document.getElementById('sortSelect');

      // Edit modal elements
      const editGuestModal = document.getElementById('editGuestModal');
      const editGuestForm = document.getElementById('editGuestForm');
      const closeEditModalBtn = document.getElementById('closeEditModalBtn');
      const cancelEditBtn = document.getElementById('cancelEditBtn');
      const editStatusEl = document.getElementById('editGuestStatus');
      let currentEditGuestId = null;

      // Delete modal elements
      const deleteGuestModal = document.getElementById('deleteGuestModal');
      const closeDeleteModalBtn = document.getElementById('closeDeleteModalBtn');
      const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
      const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
      const deleteGuestNameEl = document.getElementById('deleteGuestName');
      const deleteStatusEl = document.getElementById('deleteGuestStatus');
      let currentDeleteGuestId = null;

      // Load event details
      async function loadEventDetails() {
        try {
          const res = await fetch(`/api/events/${eventId}`);
          if (!res.ok) throw new Error('Failed to load event details');
          const response = await res.json();
          eventData = response.data;
          breadcrumbEventName.textContent = eventData.name;
        } catch (err) {
          console.error('[Guests] Error loading event:', err);
        }
      }

      // Render stats
      function renderStats() {
        const totalGuests = guests.length;
        const assignedGuestIds = new Set(assignments.map(a => a.guest_id));
        const assigned = assignedGuestIds.size;
        const unassigned = totalGuests - assigned;

        statsContainer.innerHTML = `
          <div class="bg-card/95 backdrop-blur-sm rounded-xl p-5 border border-border/60 shadow-[var(--shadow-md)] transition-all duration-150 hover:shadow-[var(--shadow-lg)]">
            <div class="text-sm font-medium text-muted-foreground mb-2">Total Guests</div>
            <div class="text-2xl font-semibold tracking-tight">${totalGuests}</div>
          </div>
          <div class="bg-card/95 backdrop-blur-sm rounded-xl p-5 border border-border/60 shadow-[var(--shadow-md)] transition-all duration-150 hover:shadow-[var(--shadow-lg)]">
            <div class="text-sm font-medium text-muted-foreground mb-2">Assigned</div>
            <div class="text-2xl font-semibold tracking-tight text-green-600">${assigned}</div>
          </div>
          <div class="bg-card/95 backdrop-blur-sm rounded-xl p-5 border border-border/60 shadow-[var(--shadow-md)] transition-all duration-150 hover:shadow-[var(--shadow-lg)]">
            <div class="text-sm font-medium text-muted-foreground mb-2">Unassigned</div>
            <div class="text-2xl font-semibold tracking-tight text-orange-600">${unassigned}</div>
          </div>
          <div class="bg-card/95 backdrop-blur-sm rounded-xl p-5 border border-border/60 shadow-[var(--shadow-md)] transition-all duration-150 hover:shadow-[var(--shadow-lg)]">
            <div class="text-sm font-medium text-muted-foreground mb-2">Completion</div>
            <div class="text-2xl font-semibold tracking-tight">${totalGuests > 0 ? Math.round((assigned / totalGuests) * 100) : 0}%</div>
          </div>
        `;
      }

      // Load guests and assignments
      async function loadGuests(showSkeleton = false) {
        console.log('[Guests] Loading guests and assignments...');

        try {
          // Fetch guests and assignments in parallel
          const [guestsRes, assignmentsRes] = await Promise.all([
            fetch(`/api/events/${eventId}/guests`),
            fetch(`/api/events/${eventId}/assignments`)
          ]);

          console.log('[Guests] Response status - Guests:', guestsRes.status, 'Assignments:', assignmentsRes.status);

          if (!guestsRes.ok) {
            const errorText = await guestsRes.text();
            console.error('[Guests] Error response:', errorText);
            throw new Error(`Failed to load guests (${guestsRes.status})`);
          }

          const guestsData = await guestsRes.json();
          console.log('[Guests] Guests data received:', guestsData);

          guests = guestsData.data || [];

          // Load assignments (may not exist yet)
          if (assignmentsRes.ok) {
            const assignmentsData = await assignmentsRes.json();
            console.log('[Guests] Assignments data received:', assignmentsData);
            assignments = assignmentsData.data || [];
          } else {
            console.log('[Guests] No assignments found or error loading assignments');
            assignments = [];
          }

          renderStats();
          filterAndSortGuests();
        } catch (err) {
          console.error('[Guests] Error loading guests:', err);
          guestsContainer.innerHTML = `
            <div class="text-center bg-white/60 backdrop-blur p-10 rounded-3xl border border-white/40 shadow">
              <p class="text-red-600 mb-2">Error loading guests</p>
              <p class="text-sm text-gray-600">${err.message}</p>
              <button onclick="location.reload()" class="mt-4 rounded-full bg-primary hover:bg-primary/90 shadow-[var(--shadow-sm)] hover:shadow-[var(--shadow-md)] active:scale-[0.98] text-white font-semibold px-6 py-2">
                Retry
              </button>
            </div>
          `;
        }
      }

      // Filter and sort guests
      function filterAndSortGuests() {
        // Filter by search term
        filteredGuests = guests.filter(guest =>
          guest.name.toLowerCase().includes(searchTerm.toLowerCase())
        );

        // Sort
        const sorted = [...filteredGuests];
        switch(sortOrder) {
          case 'name-asc':
            sorted.sort((a, b) => a.name.localeCompare(b.name));
            break;
          case 'name-desc':
            sorted.sort((a, b) => b.name.localeCompare(a.name));
            break;
          case 'created-desc':
            sorted.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
            break;
          case 'created-asc':
            sorted.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
            break;
        }

        filteredGuests = sorted;
        renderGuests();
      }

      // Render guests
      function renderGuests() {
        if (guests.length === 0) {
          guestsContainer.innerHTML = `
            <div class="text-center bg-white/60 backdrop-blur p-16 rounded-3xl border border-white/40 shadow">
              <div class="w-20 h-20 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-10 h-10 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">No guests yet</h3>
              <p class="text-gray-600 mb-6">Get started by adding your first guest</p>
              <button
                onclick="document.getElementById('addGuestBtn').click()"
                class="rounded-full bg-primary hover:bg-primary/90 shadow-[var(--shadow-sm)] hover:shadow-[var(--shadow-md)] active:scale-[0.98] text-white font-semibold px-6 py-2 inline-block"
              >
                Add Your First Guest
              </button>
            </div>
          `;
          return;
        }

        if (filteredGuests.length === 0) {
          guestsContainer.innerHTML = `
            <div class="text-center bg-white/60 backdrop-blur p-10 rounded-3xl border border-white/40 shadow">
              <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">No guests found</h3>
              <p class="text-sm text-gray-600">Try adjusting your search criteria</p>
            </div>
          `;
          return;
        }

        guestsContainer.innerHTML = `
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            ${filteredGuests.map(guest => createGuestCard(guest)).join('')}
          </div>
        `;
      }

      // Create guest card
      function createGuestCard(guest) {
        const isAssigned = assignments.some(a => a.guest_id === guest.id);
        const assignmentStatus = isAssigned
          ? '<span class="text-xs px-2.5 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded-full font-medium">Assigned</span>'
          : '<span class="text-xs px-2.5 py-1 bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-400 rounded-full font-medium">Unassigned</span>';

        // Escape quotes for data attributes
        const guestDataJson = JSON.stringify(guest).replace(/"/g, '&quot;');

        return `
          <div class="relative bg-card/95 backdrop-blur-sm rounded-xl p-5 border border-border/60 shadow-[var(--shadow-md)] hover:shadow-[var(--shadow-lg)] transition-all duration-150">
            <!-- Three-dot menu button -->
            <div class="absolute top-4 right-4 z-10">
              <button class="guest-menu-btn p-2 rounded-lg hover:bg-accent transition-colors duration-150"
                data-guest-id="${guest.id}"
                data-guest-json="${guestDataJson}"
                aria-label="Guest actions menu">
                <svg class="w-5 h-5 text-muted-foreground" fill="currentColor" viewBox="0 0 16 16">
                  <circle cx="8" cy="3" r="1.5"/>
                  <circle cx="8" cy="8" r="1.5"/>
                  <circle cx="8" cy="13" r="1.5"/>
                </svg>
              </button>
              <!-- Dropdown menu -->
              <div class="guest-menu hidden absolute right-0 mt-2 w-48 bg-card rounded-lg shadow-[var(--shadow-lg)] border border-border py-2 z-20">
                <button class="edit-guest-btn w-full text-left px-4 py-2 text-sm hover:bg-accent transition-colors duration-150 flex items-center gap-2"
                  data-guest-id="${guest.id}"
                  data-guest-json="${guestDataJson}">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                  </svg>
                  Edit Guest
                </button>
                <button class="delete-guest-btn w-full text-left px-4 py-2 text-sm text-destructive hover:bg-destructive/10 transition-colors duration-150 flex items-center gap-2"
                  data-guest-id="${guest.id}"
                  data-guest-name="${guest.name.replace(/"/g, '&quot;')}">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                  Delete Guest
                </button>
              </div>
            </div>

            <div class="flex justify-between items-start mb-4 pr-10">
              <div class="flex-1">
                <h3 class="text-base font-semibold tracking-tight mb-2">${guest.name}</h3>
                <div>${assignmentStatus}</div>
              </div>
            </div>

            <div class="space-y-2.5 text-sm">
              ${guest.age_range ? `
                <div class="flex items-center gap-2.5 text-muted-foreground">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                  <span class="capitalize">${guest.age_range}</span>
                </div>
              ` : ''}

              ${guest.dietary_restrictions ? `
                <div class="flex items-center gap-2.5 text-muted-foreground">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                  <span class="truncate">${guest.dietary_restrictions}</span>
                </div>
              ` : ''}

              ${guest.hobbies ? `
                <div class="flex items-center gap-2.5 text-muted-foreground">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="truncate">${guest.hobbies}</span>
                </div>
              ` : ''}
            </div>
          </div>
        `;
      }

      // Modal functions
      function openAddModal() {
        addGuestModal.classList.remove('hidden');
        document.getElementById('guestName').focus();
        document.body.style.overflow = 'hidden';
      }

      function closeAddModal() {
        addGuestModal.classList.add('hidden');
        addGuestForm.reset();
        addStatusEl.classList.add('hidden');
        document.body.style.overflow = '';
      }

      function openEditModal(guestId, guestData) {
        currentEditGuestId = guestId;
        document.getElementById('editGuestName').value = guestData.name || '';
        document.getElementById('editGuestAge').value = guestData.age_range || '';
        document.getElementById('editGuestDrinking').value = guestData.drinking_habits || '';
        document.getElementById('editGuestDiet').value = guestData.dietary_restrictions || '';
        document.getElementById('editGuestHobbies').value = guestData.hobbies || '';
        document.getElementById('editGuestAvoid').value = guestData.topics_to_avoid || '';
        editGuestModal.classList.remove('hidden');
        document.getElementById('editGuestName').focus();
        document.body.style.overflow = 'hidden';
      }

      function closeEditModal() {
        editGuestModal.classList.add('hidden');
        editGuestForm.reset();
        editStatusEl.classList.add('hidden');
        currentEditGuestId = null;
        document.body.style.overflow = '';
      }

      function openDeleteModal(guestId, guestName) {
        currentDeleteGuestId = guestId;
        deleteGuestNameEl.textContent = guestName;
        deleteGuestModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closeDeleteModal() {
        deleteGuestModal.classList.add('hidden');
        deleteStatusEl.classList.add('hidden');
        currentDeleteGuestId = null;
        document.body.style.overflow = '';
      }

      addGuestBtn?.addEventListener('click', openAddModal);
      closeAddModalBtn?.addEventListener('click', closeAddModal);
      cancelAddBtn?.addEventListener('click', closeAddModal);

      addGuestModal?.addEventListener('click', (e) => {
        if (e.target === addGuestModal) closeAddModal();
      });

      closeEditModalBtn?.addEventListener('click', closeEditModal);
      cancelEditBtn?.addEventListener('click', closeEditModal);

      editGuestModal?.addEventListener('click', (e) => {
        if (e.target === editGuestModal) closeEditModal();
      });

      closeDeleteModalBtn?.addEventListener('click', closeDeleteModal);
      cancelDeleteBtn?.addEventListener('click', closeDeleteModal);

      deleteGuestModal?.addEventListener('click', (e) => {
        if (e.target === deleteGuestModal) closeDeleteModal();
      });

      // Handle add guest form submission
      addGuestForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        addStatusEl.classList.add('hidden');

        const guestData = {
          name: document.getElementById('guestName').value,
          age_range: document.getElementById('guestAge').value || null,
          drinking_habits: document.getElementById('guestDrinking').value || null,
          dietary_restrictions: document.getElementById('guestDiet').value || null,
          hobbies: document.getElementById('guestHobbies').value || null,
          topics_to_avoid: document.getElementById('guestAvoid').value || null
        };

        try {
          const res = await fetch(`/api/events/${eventId}/guests`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(guestData)
          });

          if (!res.ok) {
            const errorData = await res.json();
            throw new Error(errorData.error?.message || 'Failed to add guest');
          }

          console.log('[Guests] Guest added');
          closeAddModal();
          loadGuests();
        } catch (err) {
          console.error('[Guests] Error adding guest:', err);
          addStatusEl.textContent = err.message;
          addStatusEl.classList.remove('hidden');
        }
      });

      // Handle edit guest form submission
      editGuestForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        editStatusEl.classList.add('hidden');

        if (!currentEditGuestId) {
          editStatusEl.textContent = 'No guest selected';
          editStatusEl.classList.remove('hidden');
          return;
        }

        const guestData = {
          name: document.getElementById('editGuestName').value,
          age_range: document.getElementById('editGuestAge').value || null,
          drinking_habits: document.getElementById('editGuestDrinking').value || null,
          dietary_restrictions: document.getElementById('editGuestDiet').value || null,
          hobbies: document.getElementById('editGuestHobbies').value || null,
          topics_to_avoid: document.getElementById('editGuestAvoid').value || null
        };

        try {
          const res = await fetch(`/api/guests/${currentEditGuestId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(guestData)
          });

          if (!res.ok) {
            const errorData = await res.json();
            throw new Error(errorData.error?.message || 'Failed to update guest');
          }

          console.log('[Guests] Guest updated');
          closeEditModal();
          loadGuests();
        } catch (err) {
          console.error('[Guests] Error updating guest:', err);
          editStatusEl.textContent = err.message;
          editStatusEl.classList.remove('hidden');
        }
      });

      // Handle delete guest confirmation
      confirmDeleteBtn?.addEventListener('click', async () => {
        deleteStatusEl.classList.add('hidden');

        if (!currentDeleteGuestId) {
          deleteStatusEl.textContent = 'No guest selected';
          deleteStatusEl.classList.remove('hidden');
          return;
        }

        try {
          const res = await fetch(`/api/guests/${currentDeleteGuestId}`, {
            method: 'DELETE'
          });

          if (!res.ok) {
            // Only try to parse JSON if there's content
            const text = await res.text();
            let errorMessage = 'Failed to delete guest';
            if (text) {
              try {
                const errorData = JSON.parse(text);
                errorMessage = errorData.message || errorData.error?.message || errorMessage;
              } catch (e) {
                // Not JSON, use text as message
                errorMessage = text || errorMessage;
              }
            }
            throw new Error(errorMessage);
          }

          console.log('[Guests] Guest deleted');
          closeDeleteModal();
          loadGuests();
        } catch (err) {
          console.error('[Guests] Error deleting guest:', err);
          deleteStatusEl.textContent = err.message;
          deleteStatusEl.classList.remove('hidden');
        }
      });

      // Search input with debouncing
      let searchTimeout;
      searchInput?.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          searchTerm = e.target.value;
          filterAndSortGuests();
        }, 300);
      });

      // Sort select change
      sortSelect?.addEventListener('change', (e) => {
        sortOrder = e.target.value;
        filterAndSortGuests();
      });

      // Event delegation for guest card actions
      guestsContainer?.addEventListener('click', (e) => {
        // Toggle menu dropdown
        if (e.target.closest('.guest-menu-btn')) {
          e.preventDefault();
          e.stopPropagation();
          const btn = e.target.closest('.guest-menu-btn');
          const menu = btn.nextElementSibling;

          // Close all other menus
          document.querySelectorAll('.guest-menu').forEach(m => {
            if (m !== menu) m.classList.add('hidden');
          });

          menu.classList.toggle('hidden');
          return;
        }

        // Edit guest
        if (e.target.closest('.edit-guest-btn')) {
          const btn = e.target.closest('.edit-guest-btn');
          const guestId = btn.dataset.guestId;
          const guestJson = btn.dataset.guestJson.replace(/&quot;/g, '"');
          const guestData = JSON.parse(guestJson);

          // Close the menu
          btn.closest('.guest-menu').classList.add('hidden');

          openEditModal(guestId, guestData);
          return;
        }

        // Delete guest
        if (e.target.closest('.delete-guest-btn')) {
          const btn = e.target.closest('.delete-guest-btn');
          const guestId = btn.dataset.guestId;
          const guestName = btn.dataset.guestName;

          // Close the menu
          btn.closest('.guest-menu').classList.add('hidden');

          openDeleteModal(guestId, guestName);
          return;
        }
      });

      // Click outside to close guest menus
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.guest-menu-btn') && !e.target.closest('.guest-menu')) {
          document.querySelectorAll('.guest-menu').forEach(menu => {
            menu.classList.add('hidden');
          });
        }
      });

      // Close modals on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          // Close all open menus
          document.querySelectorAll('.guest-menu').forEach(menu => {
            menu.classList.add('hidden');
          });

          // Close modals
          if (!addGuestModal.classList.contains('hidden')) {
            closeAddModal();
          } else if (!editGuestModal.classList.contains('hidden')) {
            closeEditModal();
          } else if (!deleteGuestModal.classList.contains('hidden')) {
            closeDeleteModal();
          }
        }
      });

      // Initial load
      loadEventDetails();
      loadGuests();
    })();
  </script>
</AppShell>
