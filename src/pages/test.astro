---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Tailwind Test">
  <div class="p-8">
    <h1 class="text-4xl font-bold text-blue-600 mb-4">Tailwind Test Page</h1>
    <p class="text-red-500 bg-yellow-200 p-4 rounded-lg">
      If you see this text in RED on a YELLOW background with rounded corners, Tailwind is working!
    </p>
    <div class="mt-4 bg-primary text-primary-foreground p-4 rounded-lg">
      This should use custom primary colors from CSS variables
    </div>
  </div>
</Layout>
