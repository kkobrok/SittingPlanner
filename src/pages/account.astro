---
/* eslint-disable prettier/prettier, no-console, @typescript-eslint/no-unused-vars */
import AppShell from "../layouts/AppShell.astro";
export const prerender = false;
---

<AppShell title="Account Settings">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-semibold tracking-tight mb-2">Account Settings</h1>
      <p class="text-sm text-muted-foreground">Manage your profile, preferences, and security settings</p>
    </div>

    <!-- Tabs Navigation -->
    <div class="border-b border-border mb-8">
      <nav class="flex gap-6" role="tablist">
        <button
          id="tab-profile"
          role="tab"
          aria-selected="true"
          aria-controls="panel-profile"
          class="tab-btn pb-3 px-1 text-sm font-semibold border-b-2 border-primary text-primary transition-colors"
        >
          Profile
        </button>
        <button
          id="tab-preferences"
          role="tab"
          aria-selected="false"
          aria-controls="panel-preferences"
          class="tab-btn pb-3 px-1 text-sm font-semibold border-b-2 border-transparent text-muted-foreground hover:text-foreground transition-colors"
        >
          Preferences
        </button>
        <button
          id="tab-security"
          role="tab"
          aria-selected="false"
          aria-controls="panel-security"
          class="tab-btn pb-3 px-1 text-sm font-semibold border-b-2 border-transparent text-muted-foreground hover:text-foreground transition-colors"
        >
          Security
        </button>
      </nav>
    </div>

    <!-- Tab Panels -->
    <div>
      <!-- Profile Tab -->
      <div id="panel-profile" role="tabpanel" aria-labelledby="tab-profile" class="tab-panel">
        <div class="space-y-6">
          <!-- Profile Information Card -->
          <div class="bg-card/95 backdrop-blur-sm rounded-xl p-6 border border-border/60 shadow-[var(--shadow-md)]">
            <h2 class="text-xl font-semibold mb-4">Profile Information</h2>
            <form id="profileForm" class="space-y-4">
              <div>
                <label for="profileEmail" class="block text-sm font-semibold mb-2">Email Address</label>
                <input
                  id="profileEmail"
                  type="email"
                  disabled
                  placeholder="Loading..."
                  class="w-full h-10 rounded-lg border border-input bg-muted px-3.5 text-sm cursor-not-allowed opacity-60"
                />
                <p class="text-xs text-muted-foreground mt-1">Email cannot be changed</p>
              </div>

              <div>
                <label for="profileName" class="block text-sm font-semibold mb-2">Display Name</label>
                <input
                  id="profileName"
                  type="text"
                  placeholder="Your name"
                  class="w-full h-10 rounded-lg border border-input bg-background px-3.5 text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
                />
                <p class="text-xs text-muted-foreground mt-1">Optional - used in exports and templates</p>
              </div>

              <div class="flex justify-end pt-2">
                <button
                  type="submit"
                  class="h-10 px-6 rounded-lg bg-primary text-primary-foreground font-semibold text-sm shadow-[var(--shadow-sm)] hover:bg-primary/90 hover:shadow-[var(--shadow-md)] active:scale-[0.98] transition-all duration-150"
                >
                  Save Changes
                </button>
              </div>

              <p id="profileStatus" class="text-sm hidden mt-2" role="alert" aria-live="polite"></p>
            </form>
          </div>

          <!-- Subscription Card -->
          <div class="bg-card/95 backdrop-blur-sm rounded-xl p-6 border border-border/60 shadow-[var(--shadow-md)]">
            <h2 class="text-xl font-semibold mb-4">Subscription</h2>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-muted-foreground mb-1">Current Plan</p>
                <p class="text-2xl font-bold">Free</p>
              </div>
              <button
                class="h-10 px-6 rounded-lg bg-primary text-primary-foreground font-semibold text-sm shadow-[var(--shadow-sm)] hover:bg-primary/90 hover:shadow-[var(--shadow-md)] active:scale-[0.98] transition-all duration-150"
              >
                Upgrade to Premium
              </button>
            </div>
            <div class="mt-4 p-4 bg-accent/30 rounded-lg">
              <p class="text-sm text-muted-foreground">
                Upgrade to Premium to unlock advanced features like custom templates, priority AI generation, and more.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Preferences Tab -->
      <div id="panel-preferences" role="tabpanel" aria-labelledby="tab-preferences" class="tab-panel hidden">
        <div class="space-y-6">
          <!-- Default Optimization Settings -->
          <div class="bg-card/95 backdrop-blur-sm rounded-xl p-6 border border-border/60 shadow-[var(--shadow-md)]">
            <h2 class="text-xl font-semibold mb-4">Default Optimization Weights</h2>
            <p class="text-sm text-muted-foreground mb-6">
              Set default weights for AI seating plan generation. You can override these for each event.
            </p>

            <form id="preferencesForm" class="space-y-6">
              <div>
                <div class="flex justify-between mb-2">
                  <label for="weightRelationships" class="text-sm font-semibold">Relationships</label>
                  <span id="weightRelationshipsValue" class="text-sm font-semibold text-primary">80%</span>
                </div>
                <input
                  id="weightRelationships"
                  type="range"
                  min="0"
                  max="100"
                  value="80"
                  class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-primary"
                />
                <p class="text-xs text-muted-foreground mt-1">Prioritize seating friends and family together</p>
              </div>

              <div>
                <div class="flex justify-between mb-2">
                  <label for="weightAge" class="text-sm font-semibold">Age Compatibility</label>
                  <span id="weightAgeValue" class="text-sm font-semibold text-primary">50%</span>
                </div>
                <input
                  id="weightAge"
                  type="range"
                  min="0"
                  max="100"
                  value="50"
                  class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-primary"
                />
                <p class="text-xs text-muted-foreground mt-1">Group guests of similar age ranges</p>
              </div>

              <div>
                <div class="flex justify-between mb-2">
                  <label for="weightHobbies" class="text-sm font-semibold">Hobbies & Interests</label>
                  <span id="weightHobbiesValue" class="text-sm font-semibold text-primary">60%</span>
                </div>
                <input
                  id="weightHobbies"
                  type="range"
                  min="0"
                  max="100"
                  value="60"
                  class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-primary"
                />
                <p class="text-xs text-muted-foreground mt-1">Match guests with similar interests</p>
              </div>

              <div>
                <div class="flex justify-between mb-2">
                  <label for="weightDrinking" class="text-sm font-semibold">Drinking Habits</label>
                  <span id="weightDrinkingValue" class="text-sm font-semibold text-primary">30%</span>
                </div>
                <input
                  id="weightDrinking"
                  type="range"
                  min="0"
                  max="100"
                  value="30"
                  class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-primary"
                />
                <p class="text-xs text-muted-foreground mt-1">Consider drinking preferences in seating</p>
              </div>

              <div>
                <div class="flex justify-between mb-2">
                  <label for="weightDietary" class="text-sm font-semibold">Dietary Restrictions</label>
                  <span id="weightDietaryValue" class="text-sm font-semibold text-primary">40%</span>
                </div>
                <input
                  id="weightDietary"
                  type="range"
                  min="0"
                  max="100"
                  value="40"
                  class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-primary"
                />
                <p class="text-xs text-muted-foreground mt-1">Group guests with similar dietary needs</p>
              </div>

              <div class="flex justify-between pt-4">
                <button
                  type="button"
                  id="resetPreferences"
                  class="h-10 px-6 rounded-lg border-2 border-border bg-card/50 backdrop-blur-sm font-semibold text-sm hover:bg-accent hover:border-accent-foreground/20 active:bg-accent/80 transition-all duration-150"
                >
                  Reset to Defaults
                </button>
                <button
                  type="submit"
                  class="h-10 px-6 rounded-lg bg-primary text-primary-foreground font-semibold text-sm shadow-[var(--shadow-sm)] hover:bg-primary/90 hover:shadow-[var(--shadow-md)] active:scale-[0.98] transition-all duration-150"
                >
                  Save Preferences
                </button>
              </div>

              <p id="preferencesStatus" class="text-sm hidden mt-2" role="alert" aria-live="polite"></p>
            </form>
          </div>

          <!-- Notification Settings -->
          <div class="bg-card/95 backdrop-blur-sm rounded-xl p-6 border border-border/60 shadow-[var(--shadow-md)]">
            <h2 class="text-xl font-semibold mb-4">Notifications</h2>
            <form id="notificationsForm" class="space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-semibold text-sm">Email Notifications</p>
                  <p class="text-xs text-muted-foreground">Receive updates about your events and seating plans</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input id="emailNotifications" type="checkbox" checked class="sr-only peer" />
                  <div
                    class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-ring rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"
                  >
                  </div>
                </label>
              </div>

              <div class="flex items-center justify-between">
                <div>
                  <p class="font-semibold text-sm">Weekly Digest</p>
                  <p class="text-xs text-muted-foreground">Summary of your events and activity</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input id="weeklyDigest" type="checkbox" class="sr-only peer" />
                  <div
                    class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-ring rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"
                  >
                  </div>
                </label>
              </div>

              <div class="flex justify-end pt-2">
                <button
                  type="submit"
                  class="h-10 px-6 rounded-lg bg-primary text-primary-foreground font-semibold text-sm shadow-[var(--shadow-sm)] hover:bg-primary/90 hover:shadow-[var(--shadow-md)] active:scale-[0.98] transition-all duration-150"
                >
                  Save Notifications
                </button>
              </div>

              <p id="notificationsStatus" class="text-sm hidden mt-2" role="alert" aria-live="polite"></p>
            </form>
          </div>
        </div>
      </div>

      <!-- Security Tab -->
      <div id="panel-security" role="tabpanel" aria-labelledby="tab-security" class="tab-panel hidden">
        <div class="space-y-6">
          <!-- Change Password Card -->
          <div class="bg-card/95 backdrop-blur-sm rounded-xl p-6 border border-border/60 shadow-[var(--shadow-md)]">
            <h2 class="text-xl font-semibold mb-4">Change Password</h2>
            <form id="passwordForm" class="space-y-4">
              <div>
                <label for="currentPassword" class="block text-sm font-semibold mb-2">Current Password</label>
                <input
                  id="currentPassword"
                  type="password"
                  required
                  class="w-full h-10 rounded-lg border border-input bg-background px-3.5 text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
                />
              </div>

              <div>
                <label for="newPassword" class="block text-sm font-semibold mb-2">New Password</label>
                <input
                  id="newPassword"
                  type="password"
                  required
                  minlength="8"
                  class="w-full h-10 rounded-lg border border-input bg-background px-3.5 text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
                />
                <p class="text-xs text-muted-foreground mt-1">Minimum 8 characters</p>
              </div>

              <div>
                <label for="confirmPassword" class="block text-sm font-semibold mb-2">Confirm New Password</label>
                <input
                  id="confirmPassword"
                  type="password"
                  required
                  minlength="8"
                  class="w-full h-10 rounded-lg border border-input bg-background px-3.5 text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
                />
              </div>

              <div class="flex justify-end pt-2">
                <button
                  type="submit"
                  class="h-10 px-6 rounded-lg bg-primary text-primary-foreground font-semibold text-sm shadow-[var(--shadow-sm)] hover:bg-primary/90 hover:shadow-[var(--shadow-md)] active:scale-[0.98] transition-all duration-150"
                >
                  Update Password
                </button>
              </div>

              <p id="passwordStatus" class="text-sm hidden mt-2" role="alert" aria-live="polite"></p>
            </form>
          </div>

          <!-- Danger Zone -->
          <div
            class="bg-red-50 dark:bg-red-900/10 backdrop-blur-sm rounded-xl p-6 border border-red-200 dark:border-red-800 shadow-[var(--shadow-md)]"
          >
            <h2 class="text-xl font-semibold mb-4 text-red-900 dark:text-red-300">Danger Zone</h2>
            <div class="space-y-4">
              <p class="text-sm text-red-800 dark:text-red-300">
                Once you delete your account, there is no going back. This will permanently delete all your events,
                guests, tables, and seating plans.
              </p>
              <button
                id="deleteAccountBtn"
                class="h-10 px-6 rounded-lg bg-red-600 text-white font-semibold text-sm hover:bg-red-700 transition-colors"
              >
                Delete Account
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Account Confirmation Modal -->
  <div
    id="deleteAccountModal"
    class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 p-4"
  >
    <div
      class="bg-card/95 backdrop-blur-md rounded-2xl p-6 max-w-md w-full shadow-[var(--shadow-xl)] border border-border/60"
    >
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-semibold tracking-tight text-red-600">Delete Account</h2>
        <button
          id="closeDeleteAccountModalBtn"
          class="text-muted-foreground hover:text-foreground text-2xl leading-none transition-colors duration-150"
        >
          &times;
        </button>
      </div>

      <div class="space-y-4">
        <p class="text-foreground">
          Are you absolutely sure? This action <strong>cannot be undone</strong>. This will permanently delete your
          account and remove all your data from our servers.
        </p>

        <div class="p-3 bg-red-100 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-lg">
          <p class="text-sm text-red-800 dark:text-red-300 font-medium">
            ⚠️ Warning: All your events, guests, tables, and seating plans will be permanently deleted.
          </p>
        </div>

        <div>
          <label for="deleteConfirmText" class="block text-sm font-semibold mb-2">
            Type <span class="font-mono bg-muted px-1 py-0.5 rounded">DELETE</span> to confirm
          </label>
          <input
            id="deleteConfirmText"
            type="text"
            placeholder="Type DELETE"
            class="w-full h-10 rounded-lg border border-input bg-background px-3.5 text-sm focus:outline-none focus:ring-4 focus:ring-ring transition-all duration-150"
          />
        </div>

        <div class="flex gap-3 pt-2">
          <button
            type="button"
            id="cancelDeleteAccountBtn"
            class="flex-1 h-10 rounded-lg border-2 border-border bg-card/50 backdrop-blur-sm font-semibold text-sm hover:bg-accent hover:border-accent-foreground/20 active:bg-accent/80 transition-all duration-150"
          >
            Cancel
          </button>
          <button
            id="confirmDeleteAccountBtn"
            disabled
            class="flex-1 h-10 rounded-lg bg-red-600 text-white font-semibold text-sm hover:bg-red-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-150"
          >
            Delete My Account
          </button>
        </div>

        <p id="deleteAccountStatus" class="text-sm text-red-600 hidden mt-2" role="alert" aria-live="polite"></p>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      console.log("[Account] Script loaded");

      // Tab Management
      const tabBtns = document.querySelectorAll(".tab-btn");
      const tabPanels = document.querySelectorAll(".tab-panel");

      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetPanel = btn.getAttribute("aria-controls");

          // Update tab states
          tabBtns.forEach((b) => {
            b.setAttribute("aria-selected", "false");
            b.classList.remove("border-primary", "text-primary");
            b.classList.add("border-transparent", "text-muted-foreground");
          });

          btn.setAttribute("aria-selected", "true");
          btn.classList.add("border-primary", "text-primary");
          btn.classList.remove("border-transparent", "text-muted-foreground");

          // Update panel visibility
          tabPanels.forEach((panel) => {
            panel.classList.add("hidden");
          });

          document.getElementById(targetPanel).classList.remove("hidden");
        });
      });

      // Slider value updates
      const sliders = [
        { id: "weightRelationships", valueId: "weightRelationshipsValue" },
        { id: "weightAge", valueId: "weightAgeValue" },
        { id: "weightHobbies", valueId: "weightHobbiesValue" },
        { id: "weightDrinking", valueId: "weightDrinkingValue" },
        { id: "weightDietary", valueId: "weightDietaryValue" },
      ];

      sliders.forEach(({ id, valueId }) => {
        const slider = document.getElementById(id);
        const valueDisplay = document.getElementById(valueId);

        slider?.addEventListener("input", (e) => {
          valueDisplay.textContent = `${e.target.value}%`;
        });
      });

      // Load user profile
      async function loadProfile() {
        // In dev mode with DISABLE_AUTH, we'll show mock data
        document.getElementById("profileEmail").value = "testuser@example.com";
        document.getElementById("profileName").value = "";
      }

      // Profile form submission
      const profileForm = document.getElementById("profileForm");
      const profileStatus = document.getElementById("profileStatus");

      profileForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        profileStatus.classList.add("hidden");

        const name = document.getElementById("profileName").value;

        try {
          // TODO: Implement profile update API call
          profileStatus.textContent = "Profile updated successfully";
          profileStatus.classList.remove("hidden", "text-destructive");
          profileStatus.classList.add("text-green-600");
        } catch (err) {
          profileStatus.textContent = err.message;
          profileStatus.classList.remove("hidden", "text-green-600");
          profileStatus.classList.add("text-destructive");
        }
      });

      // Preferences form submission
      const preferencesForm = document.getElementById("preferencesForm");
      const preferencesStatus = document.getElementById("preferencesStatus");

      preferencesForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        preferencesStatus.classList.add("hidden");

        const preferences = {
          relationships_weight: parseInt(document.getElementById("weightRelationships").value, 10),
          age_compatibility_weight: parseInt(document.getElementById("weightAge").value, 10),
          hobbies_weight: parseInt(document.getElementById("weightHobbies").value, 10),
          drinking_habits_weight: parseInt(document.getElementById("weightDrinking").value, 10),
          dietary_restrictions_weight: parseInt(document.getElementById("weightDietary").value, 10),
        };

        try {
          // TODO: Implement preferences update API call
          // Store in localStorage for now
          localStorage.setItem("optimizationPreferences", JSON.stringify(preferences));

          preferencesStatus.textContent = "Preferences saved successfully";
          preferencesStatus.classList.remove("hidden", "text-destructive");
          preferencesStatus.classList.add("text-green-600");
        } catch (err) {
          preferencesStatus.textContent = err.message;
          preferencesStatus.classList.remove("hidden", "text-green-600");
          preferencesStatus.classList.add("text-destructive");
        }
      });

      // Reset preferences
      const resetPreferencesBtn = document.getElementById("resetPreferences");
      resetPreferencesBtn?.addEventListener("click", () => {
        document.getElementById("weightRelationships").value = 80;
        document.getElementById("weightRelationshipsValue").textContent = "80%";
        document.getElementById("weightAge").value = 50;
        document.getElementById("weightAgeValue").textContent = "50%";
        document.getElementById("weightHobbies").value = 60;
        document.getElementById("weightHobbiesValue").textContent = "60%";
        document.getElementById("weightDrinking").value = 30;
        document.getElementById("weightDrinkingValue").textContent = "30%";
        document.getElementById("weightDietary").value = 40;
        document.getElementById("weightDietaryValue").textContent = "40%";
      });

      // Notifications form submission
      const notificationsForm = document.getElementById("notificationsForm");
      const notificationsStatus = document.getElementById("notificationsStatus");

      notificationsForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        notificationsStatus.classList.add("hidden");

        try {
          // TODO: Implement notifications update API call
          notificationsStatus.textContent = "Notification settings saved";
          notificationsStatus.classList.remove("hidden", "text-destructive");
          notificationsStatus.classList.add("text-green-600");
        } catch (err) {
          notificationsStatus.textContent = err.message;
          notificationsStatus.classList.remove("hidden", "text-green-600");
          notificationsStatus.classList.add("text-destructive");
        }
      });

      // Password form submission
      const passwordForm = document.getElementById("passwordForm");
      const passwordStatus = document.getElementById("passwordStatus");

      passwordForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        passwordStatus.classList.add("hidden");

        const currentPassword = document.getElementById("currentPassword").value;
        const newPassword = document.getElementById("newPassword").value;
        const confirmPassword = document.getElementById("confirmPassword").value;

        if (newPassword !== confirmPassword) {
          passwordStatus.textContent = "New passwords do not match";
          passwordStatus.classList.remove("hidden", "text-green-600");
          passwordStatus.classList.add("text-destructive");
          return;
        }

        try {
          // TODO: Implement password change API call
          passwordStatus.textContent = "Password updated successfully";
          passwordStatus.classList.remove("hidden", "text-destructive");
          passwordStatus.classList.add("text-green-600");
          passwordForm.reset();
        } catch (err) {
          passwordStatus.textContent = err.message;
          passwordStatus.classList.remove("hidden", "text-green-600");
          passwordStatus.classList.add("text-destructive");
        }
      });

      // Delete account modal
      const deleteAccountBtn = document.getElementById("deleteAccountBtn");
      const deleteAccountModal = document.getElementById("deleteAccountModal");
      const closeDeleteAccountModalBtn = document.getElementById("closeDeleteAccountModalBtn");
      const cancelDeleteAccountBtn = document.getElementById("cancelDeleteAccountBtn");
      const confirmDeleteAccountBtn = document.getElementById("confirmDeleteAccountBtn");
      const deleteConfirmText = document.getElementById("deleteConfirmText");
      const deleteAccountStatus = document.getElementById("deleteAccountStatus");

      function openDeleteAccountModal() {
        deleteAccountModal.classList.remove("hidden");
        document.body.style.overflow = "hidden";
      }

      function closeDeleteAccountModal() {
        deleteAccountModal.classList.add("hidden");
        deleteConfirmText.value = "";
        confirmDeleteAccountBtn.disabled = true;
        deleteAccountStatus.classList.add("hidden");
        document.body.style.overflow = "";
      }

      deleteAccountBtn?.addEventListener("click", openDeleteAccountModal);
      closeDeleteAccountModalBtn?.addEventListener("click", closeDeleteAccountModal);
      cancelDeleteAccountBtn?.addEventListener("click", closeDeleteAccountModal);

      deleteAccountModal?.addEventListener("click", (e) => {
        if (e.target === deleteAccountModal) closeDeleteAccountModal();
      });

      // Enable delete button only when "DELETE" is typed
      deleteConfirmText?.addEventListener("input", (e) => {
        confirmDeleteAccountBtn.disabled = e.target.value !== "DELETE";
      });

      // Confirm delete account
      confirmDeleteAccountBtn?.addEventListener("click", async () => {
        deleteAccountStatus.classList.add("hidden");

        try {
          // TODO: Implement account deletion API call
          alert("Account deletion would happen here. This is disabled in development mode.");
          closeDeleteAccountModal();
        } catch (err) {
          deleteAccountStatus.textContent = err.message;
          deleteAccountStatus.classList.remove("hidden");
        }
      });

      // Close modal on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !deleteAccountModal.classList.contains("hidden")) {
          closeDeleteAccountModal();
        }
      });

      // Initial load
      loadProfile();

      // Load saved preferences from localStorage
      const savedPreferences = localStorage.getItem("optimizationPreferences");
      if (savedPreferences) {
        const prefs = JSON.parse(savedPreferences);
        document.getElementById("weightRelationships").value = prefs.relationships_weight || 80;
        document.getElementById("weightRelationshipsValue").textContent = `${prefs.relationships_weight || 80}%`;
        document.getElementById("weightAge").value = prefs.age_compatibility_weight || 50;
        document.getElementById("weightAgeValue").textContent = `${prefs.age_compatibility_weight || 50}%`;
        document.getElementById("weightHobbies").value = prefs.hobbies_weight || 60;
        document.getElementById("weightHobbiesValue").textContent = `${prefs.hobbies_weight || 60}%`;
        document.getElementById("weightDrinking").value = prefs.drinking_habits_weight || 30;
        document.getElementById("weightDrinkingValue").textContent = `${prefs.drinking_habits_weight || 30}%`;
        document.getElementById("weightDietary").value = prefs.dietary_restrictions_weight || 40;
        document.getElementById("weightDietaryValue").textContent = `${prefs.dietary_restrictions_weight || 40}%`;
      }
    })();
  </script>
</AppShell>
