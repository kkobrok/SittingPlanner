---
// Professional landing page for Sitting Planner
---

<div class="min-h-screen flex flex-col bg-gradient-to-br from-background via-background to-accent/5">
  <!-- Navigation -->
  <nav class="w-full px-6 py-4 border-b border-border/40 bg-card/80 backdrop-blur-md">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
        </div>
        <span class="text-xl font-semibold tracking-tight">Sitting Planner</span>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="/auth/login"
          class="inline-flex items-center justify-center h-10 px-6 rounded-lg border border-border bg-card/50 backdrop-blur-sm font-medium hover:bg-accent transition-all duration-150"
        >
          Sign In
        </a>
        <a
          href="/auth/register"
          class="inline-flex items-center justify-center h-10 px-6 rounded-lg bg-primary text-primary-foreground font-semibold shadow-sm hover:bg-primary/90 transition-all duration-150"
        >
          Sign Up
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="flex-1 flex items-center px-6 py-20">
    <div class="max-w-7xl mx-auto w-full">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Left Content -->
        <div class="space-y-8">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 text-primary text-sm font-medium">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
            </svg>
            AI-Powered Seating Optimization
          </div>

          <h1 class="text-5xl lg:text-6xl font-bold tracking-tight leading-tight">
            Perfect Seating
            <span class="block text-primary mt-2">Made Simple</span>
          </h1>

          <p class="text-lg text-muted-foreground leading-relaxed max-w-xl">
            Create optimal seating arrangements for your events in seconds.
            AI analyzes guest preferences, relationships, and constraints to generate
            the perfect plan automatically.
          </p>

          <div class="flex flex-wrap gap-4">
            <a
              href="/auth/register"
              class="inline-flex items-center justify-center h-12 px-8 rounded-lg bg-primary text-primary-foreground font-semibold shadow-md hover:shadow-lg hover:bg-primary/90 transition-all duration-150"
            >
              Start Planning
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <a
              href="#features"
              class="inline-flex items-center justify-center h-12 px-8 rounded-lg border-2 border-border bg-card/50 backdrop-blur-sm font-semibold hover:bg-accent transition-all duration-150"
            >
              Learn More
            </a>
          </div>

          <!-- Stats -->
          <div class="flex gap-8 pt-8 border-t border-border/40">
            <div>
              <div class="text-3xl font-bold text-primary">AI</div>
              <div class="text-sm text-muted-foreground">Powered</div>
            </div>
            <div>
              <div class="text-3xl font-bold">Fast</div>
              <div class="text-sm text-muted-foreground">Optimization</div>
            </div>
            <div>
              <div class="text-3xl font-bold">100%</div>
              <div class="text-sm text-muted-foreground">Customizable</div>
            </div>
          </div>
        </div>

        <!-- Right Visual -->
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-accent/20 rounded-3xl blur-3xl"></div>
          <div class="relative bg-card/95 backdrop-blur-sm rounded-2xl border border-border/60 shadow-2xl p-8">
            <!-- Demo Preview -->
            <div class="space-y-4">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-3 h-3 rounded-full bg-red-500"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                <div class="w-3 h-3 rounded-full bg-green-500"></div>
                <span class="ml-auto text-sm text-muted-foreground">Seating Plan</span>
              </div>

              <!-- Mock seating visualization -->
              <div class="grid grid-cols-3 gap-3">
                <div class="aspect-square rounded-xl bg-primary/10 border-2 border-primary/30 flex items-center justify-center">
                  <span class="text-2xl">🪑</span>
                </div>
                <div class="aspect-square rounded-xl bg-accent/20 border-2 border-accent/30 flex items-center justify-center">
                  <span class="text-2xl">🪑</span>
                </div>
                <div class="aspect-square rounded-xl bg-primary/10 border-2 border-primary/30 flex items-center justify-center">
                  <span class="text-2xl">🪑</span>
                </div>
              </div>

              <div class="flex items-center justify-between p-4 rounded-lg bg-accent/20">
                <span class="text-sm font-medium">AI Optimization Score</span>
                <span class="text-2xl font-bold text-primary">94%</span>
              </div>

              <div class="flex gap-2">
                <div class="flex-1 h-2 rounded-full bg-primary"></div>
                <div class="flex-1 h-2 rounded-full bg-primary"></div>
                <div class="flex-1 h-2 rounded-full bg-primary"></div>
                <div class="flex-1 h-2 rounded-full bg-primary/30"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="px-6 py-24 bg-accent/10">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold tracking-tight mb-4">Powerful Features</h2>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          Everything you need to create perfect seating arrangements for any event
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="bg-card/95 backdrop-blur-sm rounded-xl p-8 border border-border/60 shadow-md hover:shadow-xl transition-all duration-150">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">AI Optimization</h3>
          <p class="text-muted-foreground">
            Claude AI analyzes guest preferences, relationships, and constraints to create optimal seating arrangements automatically.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-card/95 backdrop-blur-sm rounded-xl p-8 border border-border/60 shadow-md hover:shadow-xl transition-all duration-150">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Drag & Drop</h3>
          <p class="text-muted-foreground">
            Intuitive interface lets you manually adjust seating with simple drag-and-drop. Real-time validation ensures no conflicts.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-card/95 backdrop-blur-sm rounded-xl p-8 border border-border/60 shadow-md hover:shadow-xl transition-all duration-150">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Privacy First</h3>
          <p class="text-muted-foreground">
            Guest names are anonymized before AI processing. Your data is encrypted and never shared without permission.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="bg-card/95 backdrop-blur-sm rounded-xl p-8 border border-border/60 shadow-md hover:shadow-xl transition-all duration-150">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Visual Table Shapes</h3>
          <p class="text-muted-foreground">
            See realistic table shapes (round, rectangular, U-shape) with proper seat positioning that mimics real-world arrangements.
          </p>
        </div>

        <!-- Feature 5 -->
        <div class="bg-card/95 backdrop-blur-sm rounded-xl p-8 border border-border/60 shadow-md hover:shadow-xl transition-all duration-150">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Guest Relationships</h3>
          <p class="text-muted-foreground">
            Define relationships between guests (friends, family, colleagues) and let AI seat compatible people together.
          </p>
        </div>

        <!-- Feature 6 -->
        <div class="bg-card/95 backdrop-blur-sm rounded-xl p-8 border border-border/60 shadow-md hover:shadow-xl transition-all duration-150">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Analytics & Insights</h3>
          <p class="text-muted-foreground">
            Get optimization scores, compatibility metrics, and actionable warnings to perfect your seating plan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="px-6 py-24">
    <div class="max-w-4xl mx-auto text-center">
      <div class="bg-gradient-to-br from-primary/10 to-accent/10 rounded-3xl p-12 border border-border/40">
        <h2 class="text-4xl font-bold tracking-tight mb-4">
          Ready to Plan Your Perfect Event?
        </h2>
        <p class="text-lg text-muted-foreground mb-8 max-w-2xl mx-auto">
          Join event planners who trust AI to create optimal seating arrangements.
          Start free, no credit card required.
        </p>
        <a
          href="/auth/register"
          class="inline-flex items-center justify-center h-14 px-10 rounded-lg bg-primary text-primary-foreground font-semibold shadow-lg hover:shadow-xl hover:bg-primary/90 transition-all duration-150 text-lg"
        >
          Get Started Now
          <svg class="w-6 h-6 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="px-6 py-8 border-t border-border/40">
    <div class="max-w-7xl mx-auto text-center text-sm text-muted-foreground">
      <p>© 2024 Sitting Planner. AI-powered seating optimization for events.</p>
    </div>
  </footer>
</div>
