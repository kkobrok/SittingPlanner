---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-muted-foreground mb-6">
  {
    items.map((item, index) => (
      <>
        {index > 0 && (
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {item.href ? (
          <a
            href={item.href}
            class="hover:text-primary transition-colors duration-150"
          >
            {item.label}
          </a>
        ) : (
          <span class="text-foreground font-semibold">{item.label}</span>
        )}
      </>
    ))
  }
</nav>
