# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - it contains secrets!

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Local development (default for Supabase local setup)
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Production example (replace with your actual Supabase project values):
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-anon-public-key-here

# -----------------------------------------------------------------------------
# AUTHENTICATION BYPASS (Development Only)
# -----------------------------------------------------------------------------
# Set to "true" to bypass authentication for local development/testing
# Set to "false" or omit entirely for production
#
# When enabled:
# - All API endpoints use a mock test user (test@example.com)
# - No JWT tokens required
# - Useful for testing API endpoints without auth setup
#
# IMPORTANT: Never deploy to production with this enabled!
DISABLE_AUTH=true

# -----------------------------------------------------------------------------
# OPENROUTER API CONFIGURATION
# -----------------------------------------------------------------------------
# Required: Your OpenRouter API key for AI-powered seating plan generation
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Example (replace with your actual key):
# OPENROUTER_API_KEY=sk-or-v1-your-actual-key-here

# -----------------------------------------------------------------------------
# OPENROUTER MODEL SELECTION (Optional - configured in code)
# -----------------------------------------------------------------------------
# The default model is: anthropic/claude-3.5-sonnet
# This provides the best balance of cost, speed, and quality for seating optimization.
#
# Alternative models you can configure in src/services/openrouter.service.ts:
#
# High Performance (more expensive):
# - anthropic/claude-3-opus           - Best reasoning, highest cost
# - openai/gpt-4-turbo                - Strong performance, OpenAI's flagship
#
# Balanced (recommended):
# - anthropic/claude-3.5-sonnet       - Default, best cost/performance ratio
# - anthropic/claude-3-sonnet         - Previous generation, slightly cheaper
#
# Cost-Effective (may reduce quality):
# - anthropic/claude-3-haiku          - Fast and cheap, good for testing
# - openai/gpt-3.5-turbo              - Cheapest option, lower quality
#
# To change the model, edit defaultModel in OpenRouterService constructor.

# -----------------------------------------------------------------------------
# OPENROUTER CACHING BEHAVIOR
# -----------------------------------------------------------------------------
# The service implements automatic request caching:
# - Cache TTL: 15 minutes (900 seconds)
# - Cache Type: In-memory (cleared on server restart)
# - Cache Key: Hash of the prompt text
#
# This reduces API costs by preventing redundant calls for identical requests.
# Cache statistics available via: service.getCacheStats()
# Manual cache clearing via: service.clearCache()

# -----------------------------------------------------------------------------
# OPENROUTER MODEL PARAMETERS (Optional - configured in code)
# -----------------------------------------------------------------------------
# Default parameters in src/services/openrouter.service.ts:
#
# temperature: 0.2
#   - Controls randomness (0.0 = deterministic, 2.0 = very random)
#   - Lower values recommended for consistent seating plans
#
# max_tokens: 4000
#   - Maximum response length
#   - Sufficient for events with up to ~100 guests
#
# top_p: 0.9
#   - Nucleus sampling parameter
#   - 0.9 provides good balance between creativity and consistency
#
# To customize these, edit defaultParams in OpenRouterService constructor.

# -----------------------------------------------------------------------------
# RATE LIMITS AND RETRY BEHAVIOR
# -----------------------------------------------------------------------------
# The service automatically handles transient failures:
# - Max retry attempts: 3
# - Retry delays: 1s, 2s, 4s (exponential backoff)
# - Retryable errors: Rate limits (429), Service unavailable (503)
# - Non-retryable errors: Auth failures (401), Bad requests (400)
#
# OpenRouter rate limits vary by plan:
# - Free tier: ~20 requests/minute
# - Paid tiers: Higher limits based on your plan
#
# Check your limits at: https://openrouter.ai/account

# -----------------------------------------------------------------------------
# SECURITY NOTES
# -----------------------------------------------------------------------------
# - Never commit your actual API key to version control
# - The API key is validated on service initialization
# - Invalid/missing keys will throw an error immediately
# - API keys are never logged or exposed in error messages
# - All API communication uses HTTPS only

# -----------------------------------------------------------------------------
# TESTING
# -----------------------------------------------------------------------------
# To run the OpenRouter integration test:
#   npm run test:openrouter
#
# Or manually:
#   npx tsx scripts/test-openrouter-integration.ts
#
# The test requires a valid OPENROUTER_API_KEY to be configured.
